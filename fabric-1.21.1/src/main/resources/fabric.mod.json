{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/bonfires-to-map",
    "issues":   "https://www.curseforge.com/minecraft/mc-mods/bonfires-to-map/comments",
    "sources":  "https://github.com/KURONAMI333/bonfires-to-map"
  },
  "license": "${mod_license}",

  "environment": "*",

  "entrypoints": {
    "main":      ["com.kuronami.bonfirestomap.BonfiresToMap"],
    "client":    ["com.kuronami.bonfirestomap.BonfiresToMapClient"],
    "journeymap": ["com.kuronami.bonfirestomap.compat.jm.BtmJourneyMapPlugin"]
  },

  "depends": {
